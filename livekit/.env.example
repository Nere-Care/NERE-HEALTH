# Clé API / secret LiveKit. À changer impérativement (secret ≥ 32 caractères) :
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=remplacez-par-un-secret-dau-moins-32-caracteres

# Domaine public de la visio (enregistrement DNS A -> IP du VPS).
# Caddy génère automatiquement le certificat SSL (Let's Encrypt).
VISIO_DOMAIN=visio.example.com
